{
  "id": "wealthfolio-addon-report-converter",
  "name": "Wealthfolio Report Converter",
  "version": "1.2.0",
  "description": "Convert broker CSV and XLSX statements into Wealthfolio activity files. Supports XTB reports with preview, validation, and downloadable output.",
  "author": "Vertig0",
  "main": "dist/addon.js",
  "sdkVersion": "3.9.0",
  "minWealthfolioVersion": "3.9.0",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "wealthfolio-addon-report-converter"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "wealthfolio-addon-report-converter",
          "route": "wealthfolio-addon-report-converter",
          "label": "Report Converter",
          "icon": "files",
          "order": 100
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.9.0",
    "@wealthfolio/ui": "^3.9.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "permissions": [
    {
      "category": "files",
      "functions": [
        "openSaveDialog"
      ],
      "purpose": "Export converted data to a file"
    },
    {
      "category": "accounts",
      "functions": [
        "getAll"
      ],
      "purpose": "Read accounts for data import"
    },
    {
      "category": "activities",
      "functions": [
        "getAll",
        "import",
        "saveMany",
        "checkImport"
      ],
      "purpose": "Read and import transaction activities"
    },
    {
      "category": "market-data",
      "functions": [
        "searchTicker"
      ],
      "purpose": "Resolve renamed ticker symbols through Wealthfolio market search"
    }
  ],
  "keywords": [
    "wealthfolio",
    "addon"
  ],
  "license": "MIT",
  "icon": "files"
}
